+
+import { AppProvider, useApp } from './AppContext';
+
+const wrapper = ({ children }: { children: React.ReactNode }) => <AppProvider>{children}</AppProvider>;
+
+function setup() {
+  const hook = renderHook(() => useApp(), { wrapper });
+  const app = () => hook.result.current;
+  act(() =>
